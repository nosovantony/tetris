{
	"$schema": "../../node_modules/wrangler/config-schema.json",
	"name": "tetris-backend",
	"main": "index.ts",
	"compatibility_date": "2026-11-01",
	"workers_dev": false,
	"preview_urls": false,
	"durable_objects": {
		"bindings": [
			{ "name": "LEADERBOARD", "class_name": "LeaderboardDO" },
			{ "name": "VALIDATION", "class_name": "ValidationDO" },
			{ "name": "DUEL_ROOM", "class_name": "DuelRoomDO" },
			{ "name": "MATCHMAKER", "class_name": "MatchmakerDO" }
		]
	},
	"migrations": [
		{ "tag": "v1", "new_sqlite_classes": ["LeaderboardDO"] },
		{ "tag": "v2", "new_sqlite_classes": ["ValidationDO"] },
		{ "tag": "v3", "new_classes": ["DuelRoomDO", "MatchmakerDO"] }
	],
	"observability": { "enabled": true },
	"env": {
		"staging": {
			"name": "tetris-backend-staging",
			"workers_dev": false,
			"preview_urls": false,
			"durable_objects": {
				"bindings": [
					{ "name": "LEADERBOARD", "class_name": "LeaderboardDO" },
					{ "name": "VALIDATION", "class_name": "ValidationDO" },
					{ "name": "DUEL_ROOM", "class_name": "DuelRoomDO" },
					{ "name": "MATCHMAKER", "class_name": "MatchmakerDO" }
				]
			}
		}
	}
}
